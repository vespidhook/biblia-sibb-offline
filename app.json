{
  "expo": {
    "name": "Bíblia SIBB",
    "slug": "biblia-sibb-offline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sibb-icon.png",
    "scheme": "bibliasibboffline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/sibb-icon.png"
    },
    "android": {
      "package": "com.bibliasibb",
      "versionCode": 18,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "icon": "./assets/images/sibb-icon.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sibb-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e3a8a",
          "image": "./assets/images/logo-branco.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6713691064940085~4568455411"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb9db93f-6021-485e-9fa0-75db147c0f63"
      }
    }
  }
}
